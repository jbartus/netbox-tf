# Credentials for nbc-restore-db.sh. Copy to .env alongside it and fill in.
# The restore wipes the target instance and replaces it with the named backup.

# NetBox Labs org and the instance to restore INTO, from the cloud console url
ORG_ID=org-xxxxxxxxxxxx
TARGET_NB_ID=nb-xxxxxxxxxxxx

# which backup to restore, a uuid
BACKUP_ID=00000000-0000-0000-0000-000000000000

# NetBox Labs platform api key, not a netbox instance token
API_KEY=
